{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve site (localhost:8080)",
      "type": "node-terminal",
      "request": "launch",
      "command": "node dev-server.js",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Serving HTTP on .* port ([0-9]+)",
        "uriFormat": "http://localhost:%s"
      }
    }
  ]
}
